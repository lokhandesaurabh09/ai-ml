# Multiplication Table

num = int(input("Enter a number: "))
for i in range(1, 11):
    print(f"{num} x {i} = {num * i}")

#-----------------------------------------------

# Factorial

num = int(input("Enter a number: "))
fact = 1
for i in range(1, num + 1):
    fact *= i
print(fact)

#-----------------------------------------------

# Reverse a number

num = int(input("Enter a number: "))
reverse = 0
while num > 0:
    digit = num % 10
    reverse = reverse * 10 + digit
    num = num // 10
print(reverse)
